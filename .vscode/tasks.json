{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OCR Manga Debug",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": ["assembleDebug"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"            },
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Clean OCR Manga",
            "type": "shell", 
            "command": ".\\gradlew.bat",
            "args": ["clean"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build OCR Manga Release",
            "type": "shell",
            "command": ".\\gradlew.bat", 
            "args": ["assembleRelease"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"            },
            "problemMatcher": ["$gradle"]
        }
    ]
}
